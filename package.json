    "react-is": "^19.2.3",
    "recharts": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.16",
    "concurrently": "^9.2.1",
